{
  "name": "summer-roam",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "start": "vite --host 0.0.0.0",
    "test": "node --test tests/*.test.mjs",
    "build": "vite build && node scripts/verify-release.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "verify:release": "node scripts/verify-release.mjs",
    "package": "npm run build && node scripts/package-release.mjs",
    "format": "prettier --write \"src/**/*.js\" \"tests/**/*.{js,mjs}\" \"scripts/*.mjs\" \"*.{js,mjs}\" \"assets-source/nohara-house/*.mjs\"",
    "format:check": "prettier --check \"src/**/*.js\" \"tests/**/*.{js,mjs}\" \"scripts/*.mjs\" \"*.{js,mjs}\" \"assets-source/nohara-house/*.mjs\"",
    "format:verify": "prettier --debug-check \"src/**/*.js\" \"tests/**/*.{js,mjs}\" \"scripts/*.mjs\" \"*.{js,mjs}\" \"assets-source/nohara-house/*.mjs\"",
    "verify": "npm run format:check && npm run lint && npm test && npm run build",
    "lint": "eslint .",
    "test:unit": "node --test tests/architecture.test.mjs tests/maintenance-contracts.test.mjs tests/drive.test.mjs tests/camera-pointer.test.mjs tests/lookout-voice.test.mjs tests/house-music.test.mjs"
  },
  "dependencies": {
    "meshoptimizer": "1.3.0",
    "three": "0.180.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.12.0",
    "prettier": "3.6.2",
    "vite": "8.3.2"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
